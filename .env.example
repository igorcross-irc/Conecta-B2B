# Modo demonstração: empresa e decisores fictícios, sem internet. Apague ou deixe em branco para usar
# as fontes gratuitas reais (BrasilAPI, CNPJá, quadro societário e site da empresa).
CONECTA_MODO_DEMO=1

# Banco remoto (Neon, Supabase ou outro Postgres). Segredo: só em .env.local, nunca no repositório.
# Use a conexão DIRETA ou a pooled; o app funciona com as duas. Se vazio, usa o banco local abaixo.
# DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Login (Neon Auth). Sem estas duas, o app roda em modo demonstração, com um usuário fixo.
# O login exige DATABASE_URL (Neon). Gere o segredo com: openssl rand -base64 32
# NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.<regiao>.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=

# Pasta do banco local (Postgres embutido). Padrão: .dados. Use "memory://" para um banco descartável.
# CONECTA_DADOS=.dados

# Quando ligar ao Supabase (ainda não usado pelo código):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca coloque a chave de serviço (service role) em variável pública nem no repositório.
